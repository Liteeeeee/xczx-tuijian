# ===== 仙草甄选 AI 推荐 · 生产环境变量 =====
# 部署到服务器时，通过 `docker compose --env-file .env.production up -d` 或 CI 注入同名环境变量

# ====== 构建期注入（VITE_ 前缀：会内联进 dist JS，严禁放敏感信息）======
# 部署子路径：根路径部署 = "/"；子路径部署如 https://x.com/tuijian/ 则写 "/tuijian/"
VITE_BASE_PATH=/

# 生产 API 基地址（参考 XCZX-admin 同款跨域直连策略：
#   admin 用 VITE_BASE_URL=https://server.api.xiancaozhenxuan.cn + VITE_API_URL=/admin-api
#   这里对齐：直接打仙草甄选统一 API 网关，不再依赖 aitj.xiancaozhenxuan.cn 同域的反向代理。）
VITE_API_BASE_URL=https://aitj-api.xiancaozhenxuan.cn

# 接口统一前缀（对齐 XCZX-admin 的商城 C 端前缀 /app-api）
VITE_API_PREFIX=/app-api

VITE_APP_TITLE=仙草甄选AI推荐
VITE_APP_ENV=production
VITE_BACKEND_BASE_URL=

# ====== 容器运行期注入（不带 VITE_：只在容器内可见，不暴露给前端）======
# 后端 RuoYi C 端网关完整地址（协议 + 主机/IP + 端口，不要加末尾斜杠）
# 生产请替换为真实网关域名或内网地址，如 http://ruoyi-gateway:18081 或 https://api.xczx.example.com
XCZX_BACKEND_URL=https://aitj.xiancaozhenxuan.cn

# [选填] 容器对外暴露端口（docker-compose 映射 host 侧端口默认 8080）
XCZX_TUIJIAN_PORT=8080
